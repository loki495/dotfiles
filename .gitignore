# Fetched by scripts/install/80-bin-tools.sh at install time instead of being
# committed - see README's "bin/ - personal CLI utilities" section. todo-tray
# is deliberately NOT here - no surviving source exists to re-fetch it from,
# it stays committed as its only remaining copy.
/bin/rg
/bin/phpactor
/bin/composer
/bin/phpbrew
/bin/phpcs
/bin/phpcbf

# Compiled binaries (should be built/downloaded, not versioned)
bin/todo-tray
bin/*.o
bin/*.so

# Auto-generated completions (regenerate with make/build)
git/.git-completion.bash

# Linked in from the private repo by `./install.sh private` - see README's
# "Private dotfiles" section.
/ai/CLAUDE.private.md

# Generated by Sessioneer's host-agent/install.sh with this machine's absolute
# paths. Tracked in the private repo and linked in by `./install.sh private`;
# the enable links are machine state that `systemctl --user enable` recreates.
/.config/systemd/user/opencode-serve.service
/.config/systemd/user/sessioneer-*
/.config/systemd/user/*.wants/opencode-serve.service
/.config/systemd/user/*.wants/sessioneer-*

# Claude Code writes the skills your claude.ai account syncs into ~/.claude/skills
# (a link into this repo): proprietary content in directories named after your
# account ids, rewritten every few minutes. Never versioned.
/ai/skills/synced/
