#!/bin/bash

if [ -f ~/dotfiles/.env ]
then
    set -a
    source ~/dotfiles/.env
    set +a
fi

DIRNAME="${0%/*}"
source $DIRNAME/../bash/lib/common
source $DIRNAME/common-git

cd $LOCAL_PATH

OLD_IFS="$IFS"
IFS=""

CHANGES="`$(which git) log -p --no-merges --since \"yesterday\"`"

if [ -z "$CHANGES" ];
then
    echo "No changes detected"
else
    echo "Changes detected! Emailing!"

    DIR=`pwd`
    DIRNAME=`dirname $DIR`
    DOMAIN=`basename $DIRNAME`

    curl --url 'smtps://smtp.gmail.com:465' --ssl-reqd \
        --mail-from 'dasc495@gmail.' \
        --mail-rcpt 'you@example.com' \
        --user 'you@example.com:'$GMAIL_PASSWORD \
        -T <(echo -e 'From: you@example.com\nTo: you@example.com\nSubject: GIT CHANGES TO '$DOMAIN'\n\n'$CHANGES)

fi

IFS="$OLD_IFS"
