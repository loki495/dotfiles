#!/usr/bin/env bash

#set -euo pipefail

DIRNAME="${0%/*}"
source $DIRNAME/../bash/lib/common

check_mycnf

if [ -z "${MYSQL_FORCE_USER// }" ]
then
    FORCED_USER=""
else
    FORCED_USER="--user $MYSQL_USER"
fi

MYCNF_FULL_PATH="$MYCNF_PATH/.my.cnf.$MYSQL_DATABASE"

BACKUP_DIR=$(pwd)"/database"
MAX_PARALLEL=4

# Get tables from remote
TABLES=$(run_ssh 'mysql --defaults-file='$MYCNF_FULL_PATH' -N -e "SHOW TABLES FROM '$MYSQL_DATABASE'"')

# Convert to grep pattern
EXCLUDE_PATTERN=$(printf "%s\n" "${MYSQL_EXCLUDED_TABLES[@]}" | paste -sd '|')

if [ -n "$EXCLUDE_PATTERN" ]; then
  TABLE_LIST=($(echo "$TABLES" | grep -vE "^($EXCLUDE_PATTERN)$"))
else
  TABLE_LIST=($TABLES)
fi

TOTAL=${#TABLE_LIST[@]}
echo "✅ Found $TOTAL tables in $MYSQL_DATABASE"

DATE_DIR=$(date +%Y-%m-%d)
mkdir -p "${BACKUP_DIR}/${DATE_DIR}"

FAILURE_LOG="${BACKUP_DIR}/${DATE_DIR}/.failures.log"
rm -f "$FAILURE_LOG" "${FAILURE_LOG}.lock"

export BACKUP_DIR MYSQL_DATABASE MYCNF_FULL_PATH FORCED_USER IGNORED_TABLES_STRING TOTAL DATE_DIR TABLE_LIST DIRNAME FAILURE_LOG

# Generate index|table pairs for xargs
i=0
for TABLE in "${TABLE_LIST[@]}"; do
  i=$((i + 1))
  echo "$i|$TABLE"
done | xargs -n1 -P "$MAX_PARALLEL" bash -c '
  set -o pipefail
  IFS="|" read -r INDEX TABLE <<< "$1"

  source $DIRNAME/../bash/lib/common

  OUT_FILE="${BACKUP_DIR}/${DATE_DIR}/${MYSQL_DATABASE}:${TABLE}.sql.gz"

  echo "📍 $INDEX/'"$TOTAL"' - $TABLE..."

  run_ssh mysqldump \
    --defaults-file='"$MYCNF_FULL_PATH"' \
    --no-tablespaces \
    --databases '"$MYSQL_DATABASE"' \
    '"$FORCED_USER"' \
    --default-character-set=utf8 \
    --opt \
    --single-transaction \
    --routines \
    --triggers \
    --events \
    --no-create-db \
    --add-drop-table \
    --complete-insert \
    --tz-utc \
    --skip-routines \
    --skip-events \
    --tables $TABLE \
  | gzip -9 > "$OUT_FILE"
  DUMP_EXIT=$?

  if [ "$DUMP_EXIT" -ne 0 ]; then
    mv "$OUT_FILE" "${OUT_FILE}.FAILED" 2>/dev/null
    ( flock -x 200; echo "$TABLE (exit $DUMP_EXIT)" >> "$FAILURE_LOG"; ) 200>>"${FAILURE_LOG}.lock"
    echo "❌  $INDEX/'"$TOTAL"' - $TABLE FAILED (exit $DUMP_EXIT)."
  else
    echo "✅  $INDEX/'"$TOTAL"' - $TABLE Done."
  fi
' bash

if [ -s "$FAILURE_LOG" ]; then
  FAILED_COUNT=$(wc -l < "$FAILURE_LOG")
  echo_error "$FAILED_COUNT/$TOTAL table dump(s) failed for $MYSQL_DATABASE:"
  cat "$FAILURE_LOG"

  SUMMARY="mysqlbk on $(hostname) failed to dump $FAILED_COUNT/$TOTAL table(s) from $MYSQL_DATABASE at $(date).

$(cat "$FAILURE_LOG")"

  "$DIRNAME/../bin/notify-email" "mysqlbk FAILURE: $MYSQL_DATABASE ($FAILED_COUNT/$TOTAL tables)" "$SUMMARY" \
    || echo_error "notify-email also failed -- check GMAIL_PASSWORD in ~/dotfiles/.env"

  exit 1
fi

