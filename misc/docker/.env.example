# Secrets and host-specific values for misc/docker/docker-compose.yml.
# Docker Compose loads this file automatically from the same directory.
#
#   cp .env.example .env
#
# .env is gitignored - real tokens never get committed.

# Watchtower's HTTP API token (guards the update-trigger endpoint).
WATCHTOWER_API_TOKEN=

# wol-wake: shared token the wake endpoint requires, plus the machine to wake.
WOL_TOKEN=
WOL_TARGET_MAC=
WOL_TARGET_IP=
