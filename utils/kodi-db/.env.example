# Copy to .env and fill in. .env is gitignored; this file is not.
#
# Read by docker-compose.yml (compose loads ./.env automatically) and sourced
# by pull-and-update.sh.

# Credentials for the MariaDB container this directory starts.
MYSQL_ROOT_PASSWORD=change-me
MYSQL_PASSWORD=change-me
MYSQL_DATABASE=kodi
MYSQL_USER=kodi
MYSQL_PORT=3307

# Where pull-and-update.sh reaches that container, and which Kodi video
# database inside it to sync into (the number tracks the Kodi release).
KODI_DB_HOST=127.0.0.1
KODI_SYNC_DB=MyVideos121
