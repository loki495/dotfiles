{
  "model": "sonnet",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/laravel-post-write.sh"
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "notify-send \"Claude Code\" \"$(cat | jq -r '.message // .last_assistant_message // \": Input requested\"')\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "notify-send \"Claude Code\" \"$(cat | jq -r '.message // .last_assistant_message // \": Task done\"')\""
          },
          {
            "type": "command",
            "command": "$HOME/.claude/scripts/track-activity.sh release"
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "php $HOME/www/sessioneer/host-agent/hooks/stop.php"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/scripts/track-activity.sh acquire"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/scripts/track-activity.sh release"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/scripts/track-activity.sh acquire"
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "php $HOME/www/sessioneer/host-agent/hooks/user_prompt_submit.php"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "rtk hook claude"
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "php $HOME/www/sessioneer/host-agent/hooks/pre_tool_use.php"
          },
          {
            "type": "command",
            "command": "$HOME/.claude/scripts/track-activity.sh acquire"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "php $HOME/www/sessioneer/host-agent/hooks/session_start.php"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "php $HOME/www/sessioneer/host-agent/hooks/permission_request.php"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash $HOME/.claude/statusline-command.sh"
  },
  "theme": "dark",
  "verbose": true,
  "remoteControlAtStartup": true,
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true,
  "TrustedDirectories": [
    "/home/andres/www"
  ],
  "permissions": {
    "blockReadsOutsideWorkingDirectories": true
  }
}
