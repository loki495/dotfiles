  "model": "sonnet",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/laravel-post-write.sh"
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "notify-send \"Claude Code\" \"$(cat | jq -r '.message // .last_assistant_message // \": Input requested\"')\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "notify-send \"Claude Code\" \"$(cat | jq -r '.message // .last_assistant_message // \": Task done\"')\""
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "php /home/andres/www/personal/sessioneer/host-agent/hooks/stop.php"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/push-guard.sh"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "rtk hook claude"
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "php /home/andres/www/personal/sessioneer/host-agent/hooks/pre_tool_use.php"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "php /home/andres/www/personal/sessioneer/host-agent/hooks/session_start.php"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "php /home/andres/www/personal/sessioneer/host-agent/hooks/permission_request.php"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "php /home/andres/www/personal/sessioneer/host-agent/hooks/user_prompt_submit.php"
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/context-budget.sh"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash $HOME/.claude/statusline-command.sh"
  },
  "disableClaudeAiConnectors": true,
  "enabledPlugins": {
    "ponytail@ponytail": true,
    "hookify@claude-plugins-official": false,
    "claude-md-management@claude-plugins-official": false,
    "laravel-boost@claude-plugins-official": false,
    "context7@claude-plugins-official": false,
    "frontend-design@claude-plugins-official": false,
    "security-guidance@claude-plugins-official": true,
    "pr-review-toolkit@claude-plugins-official": false,
    "code-simplifier@claude-plugins-official": false,
    "mcp-server-dev@claude-plugins-official": false,
    "php-lsp@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "pyright-lsp@claude-plugins-official": true,
    "clangd-lsp@claude-plugins-official": true,
    "github@claude-plugins-official": true,
    "session-report@claude-plugins-official": true,
    "commit-commands@claude-plugins-official": false
  },
  "extraKnownMarketplaces": {
    "ponytail": {
      "source": {
        "source": "github",
        "repo": "DietrichGebert/ponytail"
      }
    }
  },
  "theme": "dark",
  "verbose": true,
  "remoteControlAtStartup": true,
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true
}
