# Template for import-sqlgz-files-docker.sh.
#
# Copy to a plain `.env` in the directory holding the .sql.gz dumps you want to
# import - the script sources ./.env from its working directory, not from bin/,
# so each project keeps its own. `.env` is gitignored repo-wide.

DB_CONTAINER=myproject-db
DB_USER=user
DB_PASS=pass
DB_NAME=app
