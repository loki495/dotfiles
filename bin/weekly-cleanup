#!/usr/bin/env bash
set -euo pipefail

echo "=== $(date) ==="

# root-only steps (skipped when run from a user crontab)
if [ "$(id -u)" -eq 0 ]; then
  paccache -r
  paccache -ruk0
  journalctl --vacuum-time=14d
fi

# Docker
docker container prune -f --filter until=168h
docker image prune -f
docker builder prune -f --filter until=168h

# tmp
find /tmp -mindepth 1 -mtime +7 -delete 2>/dev/null || true
find /var/tmp -mindepth 1 -mtime +30 -delete 2>/dev/null || true

echo "Done."
