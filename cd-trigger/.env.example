# Shared secret CI includes as ?token=... on the public trigger URL
# (cd.ac495.net) - generate a long random value, put the same one in both
# homie's and insights' GitHub Actions secrets as CD_TRIGGER_TOKEN.
CD_TRIGGER_TOKEN=

# Watchtower's own HTTP API token (see traefik/... or wherever Watchtower's
# compose/run config lives) - this service just relays a validated trigger
# to Watchtower's real /v1/update endpoint, never anything else.
WATCHTOWER_TOKEN=

# Override only if Watchtower's HTTP API isn't at the default location.
# WATCHTOWER_URL=http://localhost:8082/v1/update

# CD_TRIGGER_PORT=8085
