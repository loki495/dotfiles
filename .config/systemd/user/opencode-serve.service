[Unit]
Description=OpenCode headless server
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=/home/andres
ExecStart=/usr/bin/opencode serve --hostname 0.0.0.0 --port 4096 --mdns
Restart=always
RestartSec=5
Environment=HOME=/home/andres
Environment=PATH=/home/andres/.local/bin:/home/andres/.npm-global/bin:/usr/local/sbin:/usr/local/bin:/usr/bin

[Install]
WantedBy=default.target
