#!/usr/bin/env bash
# CI container jobs already run as root, so there's nothing to escalate to
# and no sudoers/PAM setup to worry about - just exec the command directly.
# Actually hit now: 80-bin-tools.sh's `sudo pacman -S ripgrep composer` goes
# through this stub during install.sh's full run. Originally added as
# defensive insurance for the neovim --global branch (still not hit -
# NVIM_INSTALL_CHOICE=1 never reaches it), which is why this comment used to
# say "not expected to actually be hit."
exec "$@"
